# Regenerable run artifacts from docker/opensees/*.py test/visualization
# scripts - large, produced by re-running the script against the Docker
# image, not curated results. The scripts themselves and their PNG output
# (output/castelnuovo/plots/) are tracked.
/results/
output/castelnuovo/*.tcl
output/castelnuovo/recorders_*/

# Raw, unrepaired intermediate from scripts/convert_ifc_to_step.py -
# scripts/repair_step_geometry.py's output (resources/ifc_examples/
# castelnuovo/example_clean_PRONTO.stp) is the tracked, usable artifact.
/export/castelnuovo_clean/

# scripts/select_interfaces_gui.py's fragmented-geometry cache - speeds up
# repeat runs (skips a ~14s STEP-load+fragment), regenerated automatically
# whenever the source STEP file is newer than the cache.
output/castelnuovo/cache/
