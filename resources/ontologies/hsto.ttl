@prefix : <https://w3id.org/hsto#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/hsto#> .

<https://w3id.org/hsto> rdf:type owl:Ontology ;
                         owl:imports <https://w3id.org/beo> ,
                                     <https://w3id.org/dot> ,
                                     <https://w3id.org/hsv> ;
                         <http://purl.org/dc/terms/creator> _:genid1 ,
                                                            _:genid2 ,
                                                            _:genid3 ,
                                                            _:genid4 ,
                                                            _:genid5 ,
                                                            _:genid6 ;
                         <http://purl.org/dc/terms/isReferencedBy> <https://doi.org/10.19282/acs.13.2025.16> ;
                         <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                         <http://purl.org/dc/terms/title> "Historic Structure Ontology (HSTO)"@en ;
                         <http://purl.org/vocab/vann/preferredNamespacePrefix> "hsto" ;
                         <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/hsto#" ;
                         owl:versionInfo "1.0.0" .

_:genid1 rdf:type <http://xmlns.com/foaf/0.1/Person> ;
          <http://xmlns.com/foaf/0.1/name> "Maria Laura Leonardi" .

_:genid2 rdf:type <http://xmlns.com/foaf/0.1/Person> ;
          <http://xmlns.com/foaf/0.1/name> "Stefano Cursi" .

_:genid3 rdf:type <http://xmlns.com/foaf/0.1/Person> ;
          <http://xmlns.com/foaf/0.1/name> "Letizia Martinelli" .

_:genid4 rdf:type <http://xmlns.com/foaf/0.1/Person> ;
          <http://xmlns.com/foaf/0.1/name> "Elena Gigliarelli" .

_:genid5 rdf:type <http://xmlns.com/foaf/0.1/Person> ;
          <http://xmlns.com/foaf/0.1/name> "Miguel Azenha" .

_:genid6 rdf:type <http://xmlns.com/foaf/0.1/Person> ;
