   },
   {
    "name": "evidence_unit_shape",
    "help": "Evidence for unit shape"
   },
   {
    "name": "evidence_unit_material",
    "help": "Evidence for unit material"
   },
   {
    "name": "evidence_mortar_quality",
    "help": "Evidence for mortar quality"
   },
   {
    "name": "evidence_horizontal_joints",
    "help": "Evidence for horizontal joints"
   },
   {
    "name": "evidence_vertical_joints",
    "help": "Evidence for vertical joints"
   },
   {
    "name": "evidence_wall_connections",
    "help": "Evidence for wall connections"
   },
   {
    "name": "evidence",
    "help": "General evidence (optional)"
   },
   {
    "name": "flags",
    "help": "Assumptions and caveats, one per line"
   },
   {
    "name": "density_kg_m3",
    "help": "Mass density (HMO has no rule for it)"
   },
   {
    "name": "density_note",
    "help": "Source of the density"
   },
   {
    "name": "reference_category",
    "help": "Code category it is compared with (optional)"
   },
   {
    "name": "reference_note",
    "help": "Note on the comparison (optional)"
   },
   {
    "name": "variant_lower",
    "help": "Lower variant, as parameter=value; ... (optional)"
   },
   {
    "name": "variant_upper",
    "help": "Upper variant, as parameter=value; ... (optional)"
   }
  ],
  "Measured": [
   {
    "name": "masonry_type",
    "help": "Masonry type",
    "ref": [
     "MasonryTypes"
    ],
    "many": false
   },
   {
    "name": "quantity",
    "help": "e.g. compressive_strength_MPa"
   },
   {
    "name": "value",
    "help": "Value"
   },
   {
    "name": "basis",
    "help": "specimen or full scale"
   },
   {
    "name": "source",
    "help": "Where it comes from"
   }
  ]
 },
 "project_keys": [
  {
   "name": "id",
   "help": "Short name of the case study, e.g. castelnuovo"
  },
  {
   "name": "title",
   "help": "Title shown on the page"
  },
  {
   "name": "description",
   "help": "One paragraph describing the case study"
  },
  {
   "name": "namespace",
   "help": "Namespace of the graph's IRIs, ending in #"
  },
  {
   "name": "centre_id",
   "help": "Identifier of the historic centre (optional)"
  },
  {
   "name": "centre_label",
   "help": "Name of the historic centre (optional)"
  },
  {
   "name": "aggregate_id",
   "help": "Identifier of the aggregate"
  },
  {
   "name": "aggregate_label",
   "help": "Description of the aggregate"
  },
  {
   "name": "technique_id",
   "help": "Identifier of the traditional construction technique (optional)"
  },
  {
   "name": "technique_label",
   "help": "Name of the technique (optional)"
  },
  {
   "name": "bim_document",
   "help": "Identifier of the BIM model in Documents"
