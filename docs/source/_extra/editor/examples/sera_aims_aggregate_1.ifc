#1169=IFCPROPERTYSINGLEVALUE('Record',$,IFCTEXT('{"format":"openbimtofem-case","version":1,"tables":{"Project":[{"key":"id","value":"sera_aims"},{"key":"title","value":"SERA-AIMS benchmark knowledge graph"},{"key":"description","value":"The half-scale stone masonry aggregate tested on the shake table within the SERA-AIMS project, the benchmark of this thesis, described with the Historic Survey (HSV), Historic Structure (HSTO), Historic Masonry (HMO) and Failure Mechanism (FMO) ontologies: the publications and the BIM model, the units, fa\X2\00E7\X0\ades and the interface between them, the mechanical properties of the masonry derived by a reasoner from its published description, next to the measured ones, and the behaviour and expected failure mechanisms of its walls."},{"key":"namespace","value":"https://example.org/sera-aims#"},{"key":"centre_id","value":""},{"key":"centre_label","value":""},{"key":"aggregate_id","value":"Specimen"},{"key":"aggregate_label","value":"Half-scale stone masonry aggregate of the SERA-AIMS test"},{"key":"technique_id","value":"DoubleLeafStoneMasonry"},{"key":"technique_label","value":"Double-leaf undressed stone masonry of historic aggregates (Basel)"},{"key":"bim_document","value":"BIMModel"},{"key":"software_doi","value":"10.5281/zenodo.23260961"}],"Organisations":[{"id":"EPFL","name":"\X2\00C9\X0\cole Polytechnique F\X2\00E9\X0\d\X2\00E9\X0\rale de Lausanne (EPFL), Switzerland"},{"id":"UNIPV","name":"University of Pavia, Italy"},{"id":"UCB","name":"University of California, Berkeley, USA"},{"id":"RWTH","name":"RWTH Aachen University, Germany"},{"id":"LNEC","name":"National Laboratory for Civil Engineering (LNEC), Portugal"},{"id":"ISISE_UMinho","name":"Institute for Sustainability and Innovation in Structural Engineering (ISISE), University of Minho"},{"id":"CNR_ISPC","name":"Institute of Heritage Science (ISPC), National Research Council of Italy (CNR)"}],"People":[{"id":"IgorTomic","name":"Igor Tomi\X2\0107\X0\","organisation":""},{