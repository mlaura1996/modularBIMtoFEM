# --- HSTO: structural decomposition ---
# Manuscript: "quoined corners indicating originally detached buildings that
# were later physically and structurally joined" -> hsto:Quoin connections
# between adjacent units. "timber floors alla romana" -> one hsto:TimberFloor
# per unit (generic - not individually surveyed per unit).
#
# NOTE: the published ontology (read in full - see this file's module
# docstring) has no object property linking a hsto:StructuralPart to the
# hsto:Facade / hsto:HorizontalStructure instances that decompose it
# (composition is presumably meant to be handled at the BEO/IFC spatial-
# containment level, not duplicated in HSTO). Rather than force that
# relationship through a property whose domain/range doesn't fit - which
# would silently produce an invalid graph - unit/facade/floor membership is
# recorded only as an rdfs:comment below. hsto:isConnectedTo (used further
# down for the Quoin individuals) is correctly typed for this: its range is
# hsto:Connection, and hsto:Quoin is a Connection subclass.

:StructuralUnit_417 a hsto:StructuralPart ;
    rdfs:comment "Decomposed into facades Facade_417a, Facade_417b, Facade_417c and one timber floor (StructuralUnit_417_Floor) - no HSTO composition property for this, see note above" .
:StructuralUnit_417_Floor a hsto:TimberFloor ;
    rdfs:comment "Generic - manuscript describes 'timber floors alla romana' for the aggregate, not surveyed per unit" .

:Facade_417a a hsto:Facade ;
    rdfs:label "Facade_417a" ;
    hsto:isMadeOf :Tufelli_masonry_typeC .
:Facade_417b a hsto:Facade ;
    rdfs:label "Facade_417b" ;
    hsto:isMadeOf :Tufelli_masonry_typeD .
:Facade_417c a hsto:Facade ;
    rdfs:label "Facade_417c" ;
    hsto:isMadeOf :Tufelli_masonry_typeB .

:StructuralUnit_418 a hsto:StructuralPart ;
    rdfs:comment "Decomposed into facades Facade_418a, Facade_418b and one timber floor (StructuralUnit_418_Floor) - no HSTO composition property for this, see note above" .
:StructuralUnit_418_Floor a hsto:TimberFloor ;
    rdfs:comment "Generic - manuscript describes 'timber floors alla romana' for the aggregate, not surveyed per unit" .

:Facade_418a a hsto:Facade ;
    rdfs:label "Facade_418a" ;
    hsto:isMadeOf :Tufelli_masonry_typeB .
:Facade_418b a hsto:Facade ;
    rdfs:label "Facade_418b" ;
    hsto:isMadeOf :Tufelli_masonry_typeD .

:StructuralUnit_419 a hsto:StructuralPart ;
    rdfs:comment "Decomposed into facades Facade_419 and one timber floor (StructuralUnit_419_Floor) - no HSTO composition property for this, see note above" .
:StructuralUnit_419_Floor a hsto:TimberFloor ;
    rdfs:comment "Generic - manuscript describes 'timber floors alla romana' for the aggregate, not surveyed per unit" .

:Facade_419 a hsto:Facade ;
    rdfs:label "Facade_419" ;
    hsto:isMadeOf :Tufelli_masonry_typeA .

:StructuralUnit_420 a hsto:StructuralPart ;
    rdfs:comment "Decomposed into facades Facade_420 and one timber floor (StructuralUnit_420_Floor) - no HSTO composition property for this, see note above" .
:StructuralUnit_420_Floor a hsto:TimberFloor ;
    rdfs:comment "Generic - manuscript describes 'timber floors alla romana' for the aggregate, not surveyed per unit" .

:Facade_420 a hsto:Facade ;
    rdfs:label "Facade_420" ;
    hsto:isMadeOf :Tufelli_masonry_typeD .

:Quoin_StructuralUnit_417_StructuralUnit_418 a hsto:Quoin ;
    rdfs:comment "Corner connection between StructuralUnit_417 and StructuralUnit_418 - manuscript evidence for quoined corners generally in this aggregate; which specific pair of units this quoin sits between is inferred from cadastral-map row order, not individually confirmed on site" .
:StructuralUnit_417 hsto:isConnectedTo :Quoin_StructuralUnit_417_StructuralUnit_418 .
:StructuralUnit_418 hsto:isConnectedTo :Quoin_StructuralUnit_417_StructuralUnit_418 .

:Quoin_StructuralUnit_418_StructuralUnit_419 a hsto:Quoin ;
    rdfs:comment "Corner connection between StructuralUnit_418 and StructuralUnit_419 - manuscript evidence for quoined corners generally in this aggregate; which specific pair of units this quoin sits between is inferred from cadastral-map row order, not individually confirmed on site" .
:StructuralUnit_418 hsto:isConnectedTo :Quoin_StructuralUnit_418_StructuralUnit_419 .
:StructuralUnit_419 hsto:isConnectedTo :Quoin_StructuralUnit_418_StructuralUnit_419 .

:Quoin_StructuralUnit_419_StructuralUnit_420 a hsto:Quoin ;
    rdfs:comment "Corner connection between StructuralUnit_419 and StructuralUnit_420 - manuscript evidence for quoined corners generally in this aggregate; which specific pair of units this quoin sits between is inferred from cadastral-map row order, not individually confirmed on site" .
:StructuralUnit_419 hsto:isConnectedTo :Quoin_StructuralUnit_419_StructuralUnit_420 .
:StructuralUnit_420 hsto:isConnectedTo :Quoin_StructuralUnit_419_StructuralUnit_420 .

:HistoricOpening_419Door a hsto:HistoricOpening ;
    rdfs:comment "Door opening with dressed stone arch, A-419/a419 photos" .
:Facade_419 hsto:hasHistoricOpening :HistoricOpening_419Door .
