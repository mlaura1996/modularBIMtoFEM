# Castelnuovo di Porto case study - HSV/HMO instance graph.
# Generated by docker/opensees/castelnuovo_hmo_graph.py from
# resources/survey_data/castelnuovo/masonry_classification.json.
# HSTO usage is intentionally minimal - see this file's module docstring.

:CastelnuovoAggregate a hsv:Document ;
    rdfs:label "Unreinforced masonry aggregate, Castelnuovo di Porto (RM), between Piazza Garibaldi and Via Umberto I" .

:SurveyCampaign_20230601 a hsv:Document ;
    rdfs:label "On-site photographic survey, 2023-06-01" ;
    hsv:hasDocument :CastelnuovoAggregate .

:CaseStudyManuscript a hsv:Document ;
    rdfs:label "Semantic modelling of historic unreinforced masonry aggregates - case study manuscript" ;
    hsv:hasDocument :CastelnuovoAggregate .

# --- Tufelli_masonry_typeA ---
# Regular tufo masonry, fairly continuous coursing, well-cut stone voussoirs at openings
# Evidence: A-419/a419 photos (WhatsApp Image 2023-06-01 at 14.50.49/50/51): stone arch over a door with well-dressed voussoirs, courses fairly regular though not perfectly continuous
# Flag: Vertical joint staggering scored 'partially_staggered' (conservative) rather than 'properly_staggered' - not directly measurable from the available photos at typical phone-camera resolution/angle
# Flag: Mortar scored plain 'lime' (conservative) rather than crediting the pozzolana content mentioned in the manuscript with a hydraulic-lime-level score - the pozzolana's real contribution to mortar performance was not tested, only described qualitatively
:Tufelli_masonry_typeA a hmo:MasonryWall ;
    rdfs:label "Tufelli_masonry_typeA" ;
    hsv:hasDocument :SurveyCampaign_20230601, :CaseStudyManuscript ;
    hmo:hasRepresentativeVolumeElement :Tufelli_masonry_typeA_RVE .

:Tufelli_masonry_typeA_RVE a hmo:RepresentativeVolumeElement ;
    hmo:hasMasonryQualityIndex :Tufelli_masonry_typeA_MQI ;
    hmo:hasHomogeneisedMechanicalProperty
        :Tufelli_masonry_typeA_CompressiveStrength ,
        :Tufelli_masonry_typeA_YoungModulus ,
        :Tufelli_masonry_typeA_ShearModulus ,
        :Tufelli_masonry_typeA_ShearStrengthTC ,
        :Tufelli_masonry_typeA_MassDensity .

:Tufelli_masonry_typeA_MQI a hmo:MasonryQualityIndex ;
    hmo:MQITotalVertical 4.55 ;
    hmo:MQITotalOutOfPlane 4.9 ;
    hmo:MQITotalInPlane 3.5 .

:Tufelli_masonry_typeA_CompressiveStrength a hmo:CompressiveStrength ;
    saref:hasValue 3.445 ;
    saref:hasUnitOfMeasurement "MPa" .

:Tufelli_masonry_typeA_YoungModulus a hmo:YoungModulus ;
    saref:hasValue 1526.6 ;
    saref:hasUnitOfMeasurement "MPa" .

:Tufelli_masonry_typeA_ShearModulus a hmo:ShearModulus ;
    saref:hasValue 440.86 ;
    saref:hasUnitOfMeasurement "MPa" .

:Tufelli_masonry_typeA_ShearStrengthTC a hmo:ShearStrengthTC ;
    saref:hasValue 0.0512 ;
    saref:hasUnitOfMeasurement "MPa" .

:Tufelli_masonry_typeA_MassDensity a hmo:MassDensity ;
    saref:hasValue 1450 ;
    saref:hasUnitOfMeasurement "kg/m3" .

# --- Tufelli_masonry_typeB ---
# Irregular tufo masonry, discontinuous coursing, brick relieving arches at openings, squared corner quoins
# Evidence: A-417/417_c (corner building, Vicolo del Cabalino - WhatsApp Image 2023-06-01 at 14.50.40/41/42/43) and A-418/418-a (WhatsApp Image 2023-06-01 at 14.50.47/48, brick arch over a round-headed window): irregular unit sizes, less continuous coursing than typeA
# Flag: Same conservative mortar assumption as typeA (plain lime, not hydraulic-boosted)
# Flag: Vertical joint staggering scored 'partially_staggered' from the visibly less regular coursing - not measured
:Tufelli_masonry_typeB a hmo:MasonryWall ;
    rdfs:label "Tufelli_masonry_typeB" ;
    hsv:hasDocument :SurveyCampaign_20230601, :CaseStudyManuscript ;
    hmo:hasRepresentativeVolumeElement :Tufelli_masonry_typeB_RVE .

:Tufelli_masonry_typeB_RVE a hmo:RepresentativeVolumeElement ;
    hmo:hasMasonryQualityIndex :Tufelli_masonry_typeB_MQI ;
    hmo:hasHomogeneisedMechanicalProperty
        :Tufelli_masonry_typeB_CompressiveStrength ,
        :Tufelli_masonry_typeB_YoungModulus ,
        :Tufelli_masonry_typeB_ShearModulus ,
        :Tufelli_masonry_typeB_ShearStrengthTC ,
        :Tufelli_masonry_typeB_MassDensity .

:Tufelli_masonry_typeB_MQI a hmo:MasonryQualityIndex ;
    hmo:MQITotalVertical 2.8 ;
    hmo:MQITotalOutOfPlane 3.5 ;
    hmo:MQITotalInPlane 2.45 .

:Tufelli_masonry_typeB_CompressiveStrength a hmo:CompressiveStrength ;
    saref:hasValue 2.616 ;
    saref:hasUnitOfMeasurement "MPa" .

:Tufelli_masonry_typeB_YoungModulus a hmo:YoungModulus ;
    saref:hasValue 1198.7 ;
    saref:hasUnitOfMeasurement "MPa" .

:Tufelli_masonry_typeB_ShearModulus a hmo:ShearModulus ;
    saref:hasValue 384.66 ;
    saref:hasUnitOfMeasurement "MPa" .

:Tufelli_masonry_typeB_ShearStrengthTC a hmo:ShearStrengthTC ;
    saref:hasValue 0.0403 ;
    saref:hasUnitOfMeasurement "MPa" .

